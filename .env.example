# Database
DATABASE_URL="postgresql://user:password@ep-hostname.region.aws.neon.tech/facultypulse?sslmode=require"

# Auth
JWT_SECRET="replace-with-at-least-32-random-characters-secret-key"
SESSION_DAYS=7
FACULTY_ID_PATTERN="^[A-Z0-9-]{4,20}$"

# App
APP_NAME="FacultyPulse"
UNIVERSITY_NAME="State Technical University"
APP_TIMEZONE="Asia/Kolkata"
ACADEMIC_YEAR_START_MONTH=7
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed
SEED_PASSWORD="DemoPassword123"

# AI (optional, Stretch S1)
AI_PROVIDER=""
AI_API_KEY=""
