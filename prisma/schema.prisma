  url       = env("postgresql://postgres.ojtnclphstwolqlkbclu:RISHEESHREYAS67@[aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true](https://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true)")
  directUrl = env("postgresql://postgres.ojtnclphstwolqlkbclu:RISHEESHREYAS67@[aws-0-ap-south-1.pooler.supabase.com:5432/postgres](https://aws-0-ap-south-1.pooler.supabase.com:5432/postgres)")
}

enum EventType {
  ATTENDED
  HOSTED
  BUSY
}

model Faculty {
  id           String   @id @default(cuid())
  facultyCode  String   @unique
  fullName     String
  email        String   @unique
  department   String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       Event[]
}

model Event {
  id            String    @id @default(cuid())
  facultyId     String
  faculty       Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  title         String
  type          EventType
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean   @default(false)
  location      String?
  department    String?
  organizer     String?
  role          String?
  description   String?
  attachmentUrl String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([facultyId, startAt])
  @@index([facultyId, type])
}


