generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventType {
  ATTENDED
  HOSTED
  BUSY
}

enum EventCategory {
  CONFERENCE
  SEMINAR
  WORKSHOP
  JOURNAL
  MEETING
  GUEST_LECTURE
  OTHER
}

model Faculty {
  id           String   @id @default(cuid())
  facultyCode  String   @unique
  fullName     String
  email        String   @unique
  department   String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       Event[]
}

model Event {
  id            String        @id @default(cuid())
  facultyId     String
  faculty       Faculty       @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  title         String
  type          EventType
  category      EventCategory @default(OTHER)
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean       @default(false)
  location      String?
  department    String?
  organizer     String?
  role          String?
  description   String?
  attachmentUrl String?

  isVerified    Boolean       @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([facultyId, startAt])
  @@index([facultyId, type])
  @@index([facultyId, isVerified])
  @@index([facultyId, category])
}
